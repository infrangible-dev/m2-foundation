<?php

declare(strict_types=1);

use Infrangible\Foundation\Block\Adminhtml\Solutions;
use Magento\Framework\Escaper;

/**
 * @author      Andreas Knollmann
 * @copyright   Copyright (c) 2014-2026 Softwareentwicklung Andreas Knollmann
 * @license     http://www.opensource.org/licenses/mit-license.php MIT
 */

/** @var Solutions $block */
/** @var Escaper $escaper */
?>
<form class="solution-refresh" action="<?= $escaper->escapeUrl($block->getRefreshUrl()) ?>" method="post">
    <?= $block->getBlockHtml('formkey') ?>
    <?php if (! $block->isLoaded()): ?>
        <div class="message message-notice">
            <?= $escaper->escapeHtml(
                __('The list has not been loaded yet. The cron job loads it every hour, or you can load it now.')
            ) ?>
        </div>
    <?php endif; ?>
    <button type="submit" class="action-secondary">
        <span><?= $escaper->escapeHtml(__('Load from Packagist')) ?></span>
    </button>
</form>
<?php if ($block->isLoaded()): ?>
    <div class="solution-table">
        <div class="solution-body">
            <div class="solution-head">
                <div class="solution-column"><?= $escaper->escapeHtml(__('Key')) ?></div>
                <div class="solution-column"><?= $escaper->escapeHtml(__('Name')) ?></div>
                <div class="solution-column"><?= $escaper->escapeHtml(__('Version')) ?></div>
                <div class="solution-column"><?= $escaper->escapeHtml(__('Date')) ?></div>
                <div class="solution-column"><?= $escaper->escapeHtml(__('Installed')) ?></div>
                <div class="solution-column">&nbsp;</div>
            </div>
            <?php foreach ($block->getItems() as $item): ?>
                <div class="solution-row solution-status-<?= $escaper->escapeHtmlAttr($item['status']) ?>">
                    <div class="solution-column"><?= $escaper->escapeHtml($item['name']) ?></div>
                    <div class="solution-column"><?= $escaper->escapeHtml($item['description']) ?></div>
                    <div class="solution-column"><?= $escaper->escapeHtml($item['version']) ?></div>
                    <div class="solution-column">
                        <?php if ($item['time'] !== ''): ?>
                            <?= $escaper->escapeHtml(
                                $block->formatDate($item['time'], IntlDateFormatter::MEDIUM, true)
                            ) ?>
                        <?php endif; ?>
                    </div>
                    <div class="solution-column"><?= $escaper->escapeHtml((string)$item['installed']) ?></div>
                    <div class="solution-column">
                        <a href="<?= $escaper->escapeUrl($block->getPackageUrl($item['name'])) ?>"
                           target="_blank" rel="noopener noreferrer"><?= $escaper->escapeHtml(__('Read more')) ?></a>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>
