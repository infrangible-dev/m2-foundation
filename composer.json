{
    "name": "infrangible/m2-foundation",
    "description": "Base module of all Infrangible modules: adds the Infrangible admin menu, an overview of all Infrangible modules with update notifications, and a contact form.",
    "type": "magento2-module",
    "version": "3.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Admin tools"
    ],
    "homepage": "https://www.infrangible.dev/modules/foundation",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "composer-runtime-api": "^2.0",
        "fewedev/base": "~2.4.0",
        "magento/framework": "~103.0.6",
        "magento/module-admin-notification": "~100.4.0",
        "magento/module-backend": "~102.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-cron": "~100.4.0",
        "magento/module-email": "~101.1.0",
        "magento/module-store": "~101.1.0",
        "magento/module-user": "~101.2.0",
        "psr/log": "~1.1.0||~2.0.0||~3.0.0",
        "symfony/console": "~5.4.0||~6.4.0||~7.4.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\Foundation\\": "src"
        }
    }
}
