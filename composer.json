{
    "name": "infrangible/m2-foundation",
    "description": "Infrangible Magento 2 Foundation",
    "type": "magento2-module",
    "version": "3.0.0",
    "license": "MIT",
    "keywords": [
        "Magento"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-foundation",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "composer-runtime-api": "^2.0",
        "fewedev/base": "^2.4",
        "magento/framework": "~103.0.6",
        "magento/module-admin-notification": "~100.4.0",
        "magento/module-backend": "~102.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-cron": "~100.4.0",
        "magento/module-email": "~101.1.0",
        "magento/module-store": "~101.1.0",
        "magento/module-user": "~101.2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.4"
    },
    "autoload": {
        "files": [
            "src/registration.php"
